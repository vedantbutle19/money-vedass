# Money Vedass Financial Management System — Environment Configuration

# Server & Runtime Environment
PORT=5000
NODE_ENV=production

# Frontend API URL (Set in Vercel project settings when connecting to Render backend)
# Example: https://money-vedass.onrender.com (leave empty for local dev)
VITE_API_URL=

# Database Configuration (Turso Cloud LibSQL or Local SQLite)
# For Turso Cloud:
# TURSO_DATABASE_URL=libsql://money-vedass-xxxx.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token
DB_PATH=data/finora.db

# Security & CORS
ALLOWED_ORIGIN=*

# Email Gateway (Resend) for OTP Password Reset
# Get your free API key (3,000 free emails/month) from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Optional custom sender (default: Money Vedass <onboarding@resend.dev>)
RESEND_FROM_EMAIL=Money Vedass <onboarding@resend.dev>

# SMS Gateway (Fast2SMS) for optional SMS OTP delivery
# Get your API key from https://www.fast2sms.com/
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Local Development Helpers
# Set to 'true' only during local testing to view simulated OTP banner in the UI
# MUST be 'false' or omitted in production environments for security
ENABLE_DEV_OTP_SIMULATION=false
