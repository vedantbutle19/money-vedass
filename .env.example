# Finora Financial Record Management System — Environment Configuration Example

# Server & Runtime Environment
PORT=5000
NODE_ENV=production

# Database Configuration
# Local SQLite default: data/finora.db
# In Vercel serverless default: /tmp/finora.db (ephemeral)
# For persistent production on serverless: specify external SQLite or PostgreSQL URL
DB_PATH=data/finora.db

# Security & CORS
# In production, restrict to your verified frontend domain (e.g., https://finora.yourdomain.com)
ALLOWED_ORIGIN=*

# SMS Gateway (Fast2SMS) for real OTP delivery
# Get your API key from https://www.fast2sms.com/
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Local Development Helpers
# Set to 'true' only during local testing to view simulated OTP banner in the UI
# MUST be 'false' or omitted in production environments for security
ENABLE_DEV_OTP_SIMULATION=false
